# Used only by common-go/db/mysql.New. NewWithConfig accepts explicit values.
DB_MYSQL_HOSTNAME=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USERNAME=example
DB_MYSQL_PASSWORD=REPLACE_ME
DB_MYSQL_DATABASE=example
# Verified TLS is the environment default. Disable only for a trusted local server.
DB_MYSQL_ISSSL=true
